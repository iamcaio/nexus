{
  "rules": {
    "database": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "apps": {
      "nexus": {
        "_release": {
          ".read": true
        },
        "users": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid",
            "database": {
              ".validate": "newData.hasChildren()"
            },
            "_migratedFrom": {
              ".validate": "newData.isString() && newData.val().length < 200"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "donext": {
        "users": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": false
          }
        }
      },
      "cogni": {
        "users": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    }
  }
}